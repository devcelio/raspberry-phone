[Unit]
Description=Telefone com IA e dashboard
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/raspberry-phone
Environment=PYTHONPATH=%h/raspberry-phone/src
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/raspberry-phone/.venv/bin/python -m raspberry_phone --web-only
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=default.target
