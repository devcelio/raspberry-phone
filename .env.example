# Nunca versione a chave real. Copie este arquivo para .env no Raspberry Pi.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_MAX_TOKENS=100
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_TIMEOUT_SECONDS=30

# scripts/bootstrap_pi.sh preenche estes campos quando encontra exatamente
# uma placa ALSA com captura e reprodução.
AUDIO_CAPTURE_DEVICE=
AUDIO_PLAYBACK_DEVICE=

# whisper = local, após gravação; deepgram = áudio enviado durante a fala.
CONVERSATION_BACKEND=local
AGENT_SESSION_SECONDS=20
AGENT_VOICE_MODEL=sonic-2
STT_BACKEND=deepgram
DEEPGRAM_API_KEY="" # Preencha com sua chave.
SPEECH_MAX_SECONDS=30
SPEECH_ENDPOINT_MS=600
RECORD_SECONDS=10
MAX_HISTORY_TURNS=4
PHRASE_MAX_CHARS=180
SYSTEM_PROMPT="Você é a voz de um telefone com inteligência artificial. Responda sempre em português brasileiro, em no máximo três frases curtas. Use texto simples, sem Markdown, listas, emojis ou URLs."

# O fallback seguro é localhost. No Raspberry, use o IP da interface Tailscale.
WEB_HOST=localhost
WEB_PORT=8080

# Caminhos opcionais (use caminhos absolutos da sua instalação).
# Quando omitidos, usam .deps/, models/ e runtime/ na raiz do projeto.
# WHISPER_CLI=
# WHISPER_MODEL=
# WHISPER_SERVER_URL=http://localhost:8081/inference
# PIPER_VOICE=
# RUNTIME_DIR=

# AGENT_VOICE_ID pode substituir a voz pública padrão definida em config.py.
